{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA CLIENT",
  "version": "0.1.0",
  "identifier": "com.nova.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOVA CLIENT",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "icon": [],
    "category": "Game",
    "shortDescription": "A new home for Minecraft Java"
  }
}